{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "toolchain-identity bootstrap v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "librelane_revision",
    "yosys_revision",
    "yosys_native",
    "pyosys_roots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "reference",
        "stock",
        "candidate"
      ]
    },
    "librelane_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "yosys_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "yosys_native": {
      "type": "string"
    },
    "pyosys_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
